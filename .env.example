# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Backend only. Bypasses Row Level Security: keep it secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- API ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Live data refresh (see docs/live_refresh.md) ---
# Free key from https://explore.openaq.org/register
OPENAQ_API_KEY=
# API: check for new readings and a new daily bundle every N minutes (0 or unset = off)
LIVE_REFRESH_MINUTES=
# API: public URL of the daily bundle in Supabase Storage (set after the first upload)
LIVE_BUNDLE_URL=
